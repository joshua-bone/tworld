{
  "name": "tworld",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev --",
    "build": "npm --workspace web run build --",
    "test": "npm --workspace web run test --",
    "typecheck": "npm --workspace web run typecheck --",
    "legacy": "./scripts/run_legacy.sh",
    "perf:bench": "npm --workspace web run perf:bench --",
    "perf:guard": "npm --workspace web run perf:guard --",
    "verify:ms-replays": "npm --workspace web run verify:ms-replays --",
    "verify:lynx-replays": "npm --workspace web run verify:lynx-replays --",
    "verify:all-replays": "npm --workspace web run verify:all-replays --",
    "verify:ms-replays:parallel": "TWORLD_MS_REPLAY_SWEEP_JOBS=${TWORLD_MS_REPLAY_SWEEP_JOBS:-999} npm run verify:ms-replays --",
    "verify:lynx-replays:parallel": "TWORLD_LYNX_REPLAY_SWEEP_JOBS=${TWORLD_LYNX_REPLAY_SWEEP_JOBS:-999} npm run verify:lynx-replays --",
    "verify:all-replays:parallel": "TWORLD_REPLAY_SWEEP_JOBS=${TWORLD_REPLAY_SWEEP_JOBS:-999} npm run verify:all-replays --"
  }
}
