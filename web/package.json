{
  "name": "tworld-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.project.app.json && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.project.app.json",
    "typecheck:content": "tsc -b tsconfig.project.content.json",
    "typecheck:game-core": "tsc -b tsconfig.project.game-core.json",
    "typecheck:ruleset-ms": "tsc -b tsconfig.project.ruleset-ms.json",
    "typecheck:ruleset-lynx": "tsc -b tsconfig.project.ruleset-lynx.json",
    "typecheck:undo-runtime": "tsc -b tsconfig.project.undo-runtime.json",
    "typecheck:browser-support": "tsc -b tsconfig.project.browser-support.json",
    "typecheck:game-runtime": "tsc -b tsconfig.project.game-runtime.json",
    "typecheck:player-web": "tsc -b tsconfig.project.player-web.json",
    "typecheck:app": "tsc -b tsconfig.project.app.json",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck:all": "tsc -b tsconfig.project.app.json && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "verify:ms-replays": "vite-node src/replay-verifier/compose/verifyRulesetSolutionReplays.ts MS",
    "verify:lynx-replays": "vite-node src/replay-verifier/compose/verifyRulesetSolutionReplays.ts Lynx",
    "verify:all-replays": "vite-node src/replay-verifier/compose/verifyAllSolutionReplays.ts",
    "perf:bench": "vite-node src/perf/compose/benchmarkInteractiveSessions.ts",
    "perf:guard": "vite-node src/perf/compose/benchmarkInteractiveSessions.ts --guard"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.59.0"
  }
}
