{
  "extends": "./tsconfig.project-base.json",
  "compilerOptions": {
    "outDir": "./.tsbuild/ccsolver-runtime",
    "tsBuildInfoFile": "./.tsbuild/ccsolver-runtime.tsbuildinfo"
  },
  "include": [
    "src/ccsolver-runtime/ports/**/*.ts",
    "src/ccsolver-runtime/impl/**/*.ts",
    "src/ccsolver-runtime/compose/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/ccsolver-runtime/compose/runP1aStaticAnalysis.ts",
    "src/ccsolver-runtime/compose/p2a-review/buildP2aRuntimeReviewOutputs.ts",
    "src/ccsolver-runtime/compose/p2a-review/runP2aRuntimeReviewPackets.ts",
    "src/ccsolver-runtime/compose/p3-review/buildP3ReviewOutputs.ts",
    "src/ccsolver-runtime/compose/p3-review/runP3ReviewOutputs.ts",
    "src/ccsolver-runtime/compose/p4a-review/buildP4aReviewOutputs.ts",
    "src/ccsolver-runtime/compose/p4a-review/buildSyntheticFailedCanary.ts",
    "src/ccsolver-runtime/compose/p4a-review/runP4aReviewOutputs.ts",
    "src/ccsolver-runtime/compose/p5-review/buildP5ReviewOutputs.ts",
    "src/ccsolver-runtime/compose/p5-review/certifyKeyPyramidP5Replay.ts",
    "src/ccsolver-runtime/compose/p5-review/runExactKeyPyramidNativeReplay.ts",
    "src/ccsolver-runtime/compose/p5-review/runP5ReviewOutputs.ts",
    "src/ccsolver-runtime/compose/p4b-dossier/**/*.ts",
    "src/ccsolver-runtime/compose/p6a-review/**/*.ts",
    "src/ccsolver-runtime/compose/p6b-p7a-review/**/*.ts",
    "src/ccsolver-runtime/compose/p1b-curriculum/measureP1bShardCases.ts",
    "src/ccsolver-runtime/compose/p1b-curriculum/runP1bCheckedArtifacts.ts",
    "src/ccsolver-runtime/compose/p1b-curriculum/runP1bDistributedShards.ts",
    "src/ccsolver-runtime/compose/p1b-curriculum/runP1bMeasuredShard.ts",
    "src/ccsolver-runtime/compose/p1b-curriculum/writeFixedOutputsTransactionally.ts"
  ],
  "references": [
    { "path": "../ccsolver/tsconfig.json" },
    { "path": "./tsconfig.project.ruleset-ms.json" },
    { "path": "./tsconfig.project.ruleset-lynx.json" },
    { "path": "./tsconfig.project.undo-runtime.json" }
  ]
}
